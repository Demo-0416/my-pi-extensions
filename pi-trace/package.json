{
  "name": "@demo-0416/pi-trace",
  "version": "0.1.3",
  "description": "pi extension: deepseek-harness-style trajectory view — timeline gantt, turn-grouped ledger, rich detail panel, live SSE streaming",
  "keywords": [
    "pi-package",
    "pi-extension",
    "trace",
    "trajectory",
    "observability",
    "deepseek-harness"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "src/index.ts",
  "license": "MIT",
  "author": "Demo-0416",
  "repository": {
    "type": "git",
    "url": "https://github.com/Demo-0416/my-pi-extensions.git",
    "directory": "pi-trace"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/index.ts",
    "src/collector.ts",
    "src/server.ts",
    "src/store.ts",
    "src/model.ts",
    "src/stats.ts",
    "src/session-loader.ts",
    "src/web/dist/",
    "src/web/index.html",
    "src/web/theme.css",
    "src/web/NOTICE.md",
    "src/web/vendor/",
    "src/web/primitives/",
    "src/web/adapter.ts",
    "src/web/host.tsx",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "IMPLEMENTATION.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "build:web": "cd src/web && npm ci --include=dev && npm run build",
    "prepublishOnly": "npm run build:web && npm test",
    "test": "node --test scripts/test-stats.mjs && node scripts/smoke-m8.mjs",
    "test:e2e": "cd src/web && node smoke-e2e.mjs"
  }
}
